---
// Self-hosted fonts (ADR-0001): only the subsets each language needs; browsers fetch a file only when its glyphs are used.
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-500.css';
import '@fontsource/ibm-plex-sans/cyrillic-600.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
// Display serif for headings (brand guide v0.3): Cormorant Garamond for Latin and Cyrillic, Markazi Text for Persian.
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/cyrillic-500.css';
import '@fontsource/cormorant-garamond/cyrillic-600.css';
import '@fontsource/cormorant-garamond/cyrillic-500-italic.css';
import '@fontsource/markazi-text/arabic-500.css';
import '@fontsource/markazi-text/arabic-600.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CypressWatermark from '../components/CypressWatermark.astro';
import QuickBar from '../components/QuickBar.astro';
import LangSuggestBar from '../components/LangSuggestBar.astro';
import { defaultLang, languages, langMeta, localizePath, unlocalizePath, useTranslations, type Lang } from '../i18n';
import { channelLink, cityLocation } from '../lib/contact';
import { serializeJsonLd } from '../lib/structured-data';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page */
  schema?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  image?: { src: string; alt?: string };
  /** Languages that have a version of this page. */
  localizedLanguages?: readonly Lang[];
  /** Language switch destination when a translation is missing. */
  languageFallback?: string;
}

const {
  lang, title, description, schema = [], noindex = false, ogType = 'website',
  image, localizedLanguages = languages, languageFallback,
} = Astro.props;
const { dict } = useTranslations(lang);
const path = unlocalizePath(Astro.url.pathname);
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(localizePath(lang, path));
const pageTitle = title === dict.meta.homeTitle ? title : `${title} | ${dict.meta.siteName}`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': abs('/#organization'),
  name: 'Asperlos',
  alternateName: ['اسپرلوس', 'Асперлос'],
  url: abs('/'),
  logo: abs('/apple-touch-icon.png'),
  description: dict.meta.homeDescription,
  foundingDate: '2025',
  address: {
    '@type': 'PostalAddress',
    addressLocality: cityLocation.name,
    addressCountry: 'IR',
  },
  telephone: channelLink('phone').display,
  email: channelLink('email').display,
  sameAs: [channelLink('linkedin').href],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': abs('/#website'),
  url: abs('/'),
  name: 'Asperlos',
  alternateName: ['اسپرلوس', 'Асперлос'],
  publisher: { '@id': organization['@id'] },
};
const structuredData = [organization, ...(path === '/' && lang === defaultLang ? [website] : []), ...schema];
---
<!doctype html>
<html lang={lang} dir={langMeta[lang].dir}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="canonical" href={canonical}>
  {!noindex && localizedLanguages.length > 1 && localizedLanguages.map((l) => (
    <link rel="alternate" hreflang={langMeta[l].hreflang} href={abs(localizePath(l, path))}>
  ))}
  {!noindex && localizedLanguages.length > 1 && localizedLanguages.includes(defaultLang) && (
    <link rel="alternate" hreflang="x-default" href={abs(localizePath(defaultLang, path))}>
  )}

  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="Asperlos">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={abs(image?.src ?? '/og-image.png')}>
  {image?.alt && <meta property="og:image:alt" content={image.alt}>}
  <meta property="og:locale" content={langMeta[lang].ogLocale}>
  {localizedLanguages.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={langMeta[l].ogLocale}>)}

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#08275A">
  <link rel="sitemap" href="/sitemap-index.xml">

  {structuredData.map((s) => <script type="application/ld+json" set:html={serializeJsonLd(s)} />)}
  <!-- Scroll animations only when JS runs and the visitor has not asked for reduced motion. -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
  </script>
</head>
<body>
  <div class="site-background" data-site-background aria-hidden="true"><CypressWatermark tone="paper" /></div>
  {localizedLanguages.length === languages.length && <LangSuggestBar lang={lang} path={path} />}
  <Header lang={lang} path={path} localizedLanguages={localizedLanguages} languageFallback={languageFallback} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <QuickBar lang={lang} />

  <script>
    // Reveal [data-reveal] blocks as they enter the viewport; drift [data-parallax] decorations with the scroll.
    const root = document.documentElement;
    if (root.classList.contains('motion')) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      const layers = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
      if (layers.length) {
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          for (const el of layers) {
            // Measure the (untransformed) container, so the offset never feeds back into itself.
            const r = (el.parentElement ?? el).getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) continue;
            const offset = (r.top + r.height / 2 - vh / 2) * -Number(el.dataset.parallax);
            el.style.translate = `0 ${offset.toFixed(1)}px`;
          }
          ticking = false;
        };
        window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        update();
      }
    } else {
      document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
    }
  </script>
</body>
</html>
