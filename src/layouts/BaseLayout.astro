---
// Self-hosted fonts (ADR-0001): only the subsets each language needs; browsers fetch a file only when its glyphs are used.
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-500.css';
import '@fontsource/ibm-plex-sans/cyrillic-600.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
// Display serif for headings (brand guide v0.3): Cormorant Garamond for Latin and Cyrillic, Markazi Text for Persian.
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/cyrillic-500.css';
import '@fontsource/cormorant-garamond/cyrillic-600.css';
import '@fontsource/cormorant-garamond/cyrillic-500-italic.css';
import '@fontsource/markazi-text/arabic-500.css';
import '@fontsource/markazi-text/arabic-600.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickBar from '../components/QuickBar.astro';
import LangSuggestBar from '../components/LangSuggestBar.astro';
import { languages, langMeta, localizePath, unlocalizePath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page */
  schema?: object[];
  noindex?: boolean;
}

const { lang, title, description, schema = [], noindex = false } = Astro.props;
const { dict } = useTranslations(lang);
const path = unlocalizePath(Astro.url.pathname);
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(localizePath(lang, path));
const pageTitle = title === dict.meta.homeTitle ? title : `${title} | ${dict.meta.siteName}`;

// Facts from the company registration (docs/brand-guide.md, section 1); kept language-neutral so all pages agree.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Asperlos',
  alternateName: ['آسپرلوس', 'Асперлос'],
  legalName: 'Asperlos Gostar Fardad Trading Co. (LLC)',
  url: abs('/'),
  logo: abs('/apple-touch-icon.png'),
  description: dict.meta.homeDescription,
  foundingDate: '2025',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'No. 100, Meysam Shomali 20, Tabarsi Shomali 9, Tabarsi Blvd.',
    addressLocality: 'Mashhad',
    postalCode: '9177874616',
    addressCountry: 'IR',
  },
  telephone: '+98 51 3878 8331',
  identifier: { '@type': 'PropertyValue', propertyID: 'Iran national ID', value: '14015013271' },
  areaServed: { '@type': 'Country', name: 'Iran' },
};
---
<!doctype html>
<html lang={lang} dir={langMeta[lang].dir}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="canonical" href={canonical}>
  {languages.map((l) => <link rel="alternate" hreflang={langMeta[l].hreflang} href={abs(localizePath(l, path))}>)}
  <link rel="alternate" hreflang="x-default" href={abs(path)}>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Asperlos">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={abs('/og-image.png')}>
  <meta property="og:locale" content={langMeta[lang].ogLocale}>

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#08275A">
  <link rel="sitemap" href="/sitemap-index.xml">

  {[organization, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <!-- Scroll animations only when JS runs and the visitor has not asked for reduced motion. -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
  </script>
</head>
<body>
  <LangSuggestBar lang={lang} path={path} />
  <Header lang={lang} path={path} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <QuickBar lang={lang} />

  <script>
    // Reveal [data-reveal] blocks as they enter the viewport; drift [data-parallax] decorations with the scroll.
    const root = document.documentElement;
    if (root.classList.contains('motion')) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      const layers = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
      if (layers.length) {
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          for (const el of layers) {
            // Measure the (untransformed) container, so the offset never feeds back into itself.
            const r = (el.parentElement ?? el).getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) continue;
            const offset = (r.top + r.height / 2 - vh / 2) * -Number(el.dataset.parallax);
            el.style.translate = `0 ${offset.toFixed(1)}px`;
          }
          ticking = false;
        };
        window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        update();
      }
    } else {
      document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
    }
  </script>
</body>
</html>
