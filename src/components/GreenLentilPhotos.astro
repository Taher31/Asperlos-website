---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  placement: 'cover' | 'gallery';
}

const { lang, placement } = Astro.props;
const { dict } = useTranslations(lang);
const copy = {
  en: {
    title: 'Green lentil photos',
    note: 'Illustrations generated with AI.',
    bulk: 'A heap of whole green lentils on a pale surface',
    macro: 'Close-up of whole green lentils with mottled seed coats',
    scoop: 'Green lentils in a metal sampling scoop',
    bowl: 'Green lentils in a ceramic bowl',
    sample: 'Individual green lentils spread on a pale surface',
    sack: 'Green lentils spilling from a plain jute sack',
  },
  fa: {
    title: 'تصاویر عدس سبز',
    note: 'تصاویر نمادین ساخته‌شده با هوش مصنوعی.',
    bulk: 'توده‌ای از دانه‌های کامل عدس سبز روی سطح روشن',
    macro: 'نمای نزدیک دانه‌های کامل عدس سبز با پوست خال‌دار',
    scoop: 'دانه‌های عدس سبز در پیمانهٔ فلزی نمونه‌گیری',
    bowl: 'دانه‌های عدس سبز در ظرف سرامیکی',
    sample: 'دانه‌های پراکندهٔ عدس سبز روی سطح روشن',
    sack: 'دانه‌های عدس سبز ریخته‌شده از یک کیسهٔ کنفی ساده',
  },
  ru: {
    title: 'Фотографии зеленой чечевицы',
    note: 'Иллюстрации, созданные с помощью ИИ.',
    bulk: 'Цельные зерна зеленой чечевицы на светлой поверхности',
    macro: 'Крупный план цельных зерен зеленой чечевицы с крапчатой оболочкой',
    scoop: 'Зеленая чечевица в металлическом совке для отбора проб',
    bowl: 'Зеленая чечевица в керамической миске',
    sample: 'Отдельные зерна зеленой чечевицы на светлой поверхности',
    sack: 'Зеленая чечевица, высыпающаяся из джутового мешка без маркировки',
  },
}[lang];

const files = import.meta.glob<ImageMetadata>('../assets/green-lentils/*.webp', {
  eager: true,
  import: 'default',
});
const photoOrder = ['bulk', 'macro', 'scoop', 'bowl', 'sample', 'sack'] as const;
const [cover, ...gallery] = photoOrder.flatMap((id) => {
  const image = files[`../assets/green-lentils/${id}.webp`];
  return image ? [{ image, alt: copy[id] }] : [];
});
---

{placement === 'cover' && cover && (
  <figure class="cover">
    <Image src={cover.image} alt={cover.alt} widths={[320, 600, 960]} sizes="(max-width: 960px) min(480px, 92vw), 300px" />
    <figcaption>
      <span>{dict.products.illustration}</span>
      {gallery.length > 0 && <a class="text-link" href="#green-lentil-photos">{copy.title}</a>}
    </figcaption>
  </figure>
)}

{placement === 'gallery' && gallery.length > 0 && (
  <section class="section gallery" id="green-lentil-photos" aria-labelledby="green-lentil-photos-title">
    <div class="wrap">
      <h2 class="h2" id="green-lentil-photos-title">{copy.title}</h2>
      <p class="notice">{copy.note}</p>
      <ul class="photos" role="list">
        {gallery.map(({ image, alt }, index) => (
          <li>
            <Image
              src={image}
              alt={alt}
              widths={[320, 480, 640, 960, 1200]}
              sizes={index === 0
                ? '(max-width: 720px) 92vw, (max-width: 1240px) 45vw, 560px'
                : index === 1
                  ? '(max-width: 720px) 44vw, (max-width: 1240px) 45vw, 560px'
                  : '(max-width: 720px) 44vw, (max-width: 1240px) 30vw, 365px'}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .cover {
    margin: 0 0 8px;
    max-width: 480px;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .cover img {
    border-radius: 3px 3px 0 0;
  }

  figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 12px;
    padding: 10px 14px;
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .gallery {
    border-block-start: 1px solid var(--rule);
  }

  .gallery .h2 {
    margin-bottom: 8px;
  }

  .notice {
    margin: 0 0 24px;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(10px, 2vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photos li {
    grid-column: span 2;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--sand);
  }

  .photos li:nth-child(-n + 2) {
    grid-column: span 3;
  }

  .cover img,
  .photos img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .photos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .photos li,
    .photos li:nth-child(-n + 2) { grid-column: span 1; }
    .photos li:first-child { grid-column: 1 / -1; }
  }
</style>
