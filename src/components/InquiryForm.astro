---
// Posts to public/api/inquiry.php. Works without JavaScript (the server redirects to the confirmation page);
// with JavaScript it shows errors inline instead of leaving the page.
import { getProducts, slugOf } from '../lib/content';
import { localizePath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Pre-selected product slug */
  product?: string;
  idPrefix?: string;
}
const { lang, product, idPrefix = 'inq' } = Astro.props;
const { dict } = useTranslations(lang);
const products = await getProducts(lang);
const id = (name: string) => `${idPrefix}-${name}`;
---
<form
  class="form"
  method="post"
  action="/api/inquiry.php"
  data-inquiry
  data-sent-url={localizePath(lang, '/inquiry/sent/')}
  data-msg-sending={dict.inquiry.sending}
  data-msg-error={dict.inquiry.error}
  data-msg-contact-error={dict.inquiry.contactError}
  data-msg-email-error={dict.inquiry.emailError}
  data-msg-phone-error={dict.inquiry.phoneError}
  data-msg-validation-error={dict.inquiry.validationError}
  data-msg-rate-error={dict.inquiry.rateError}
>
  <input type="hidden" name="lang" value={lang}>
  <!-- Spam trap: people never see or fill this field. -->
  <div class="trap" aria-hidden="true">
    <label for={id('website')}>Website</label>
    <input id={id('website')} name="website" tabindex="-1" autocomplete="off">
  </div>

  <div class="field">
    <label for={id('name')}>{dict.inquiry.name}</label>
    <input id={id('name')} name="name" autocomplete="name" required maxlength="100">
  </div>
  <fieldset class="contact">
    <legend>{dict.inquiry.contactGuide}</legend>
    <div class="contact-fields">
      <div class="field">
        <label for={id('email')}>{dict.inquiry.email}</label>
        <input id={id('email')} name="email" type="email" autocomplete="email" maxlength="254" dir="ltr">
      </div>
      <div class="field">
        <label for={id('phone')}>{dict.inquiry.phone}</label>
        <input id={id('phone')} name="phone" type="tel" autocomplete="tel" maxlength="40" dir="ltr">
      </div>
    </div>
  </fieldset>
  <div class="field">
    <label for={id('product')}>{dict.inquiry.product} <small>{dict.inquiry.optional}</small></label>
    <select id={id('product')} name="product" data-product-select>
      <option value="">{dict.inquiry.choose}</option>
      {products.map((p) => <option value={slugOf(p)} selected={slugOf(p) === product}>{p.data.title}</option>)}
      <option value="other">{dict.inquiry.other}</option>
    </select>
  </div>
  <div class="field">
    <label for={id('msg')}>{dict.inquiry.msg} <small>{dict.inquiry.optional}</small></label>
    <textarea id={id('msg')} name="message" maxlength="2000" aria-describedby={id('msg-hint')}></textarea>
    <p class="hint" id={id('msg-hint')}>{dict.inquiry.requestHint}</p>
  </div>
  <div class="submit">
    <button class="btn btn-gold" type="submit">{dict.cta.send}</button>
    <p id={id('status')} class="status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-inquiry]').forEach((form) => {
    // Pre-select the product from ?product=<slug> (links from product pages).
    const params = new URLSearchParams(location.search);
    const wanted = params.get('product');
    const select = form.querySelector<HTMLSelectElement>('[data-product-select]');
    if (wanted && select && [...select.options].some((o) => o.value === wanted)) select.value = wanted;

    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const phone = form.querySelector<HTMLInputElement>('input[name="phone"]')!;
    const contactFields = [email, phone];
    const errorFields = new Map([
      ['contact', contactFields],
      ['email', [email]],
      ['phone', [phone]],
    ]);
    const messages = new Map([
      ['contact', form.dataset.msgContactError],
      ['email', form.dataset.msgEmailError],
      ['phone', form.dataset.msgPhoneError],
      ['validation', form.dataset.msgValidationError],
      ['rate', form.dataset.msgRateError],
    ]);

    const clearContactError = () => {
      for (const field of contactFields) {
        field.removeAttribute('aria-invalid');
        field.removeAttribute('aria-describedby');
      }
    };
    const showError = (error: string) => {
      clearContactError();
      status.textContent = messages.get(error) ?? form.dataset.msgError!;
      status.classList.add('error');
      const fields = errorFields.get(error) ?? [];
      for (const field of fields) {
        field.setAttribute('aria-invalid', 'true');
        field.setAttribute('aria-describedby', status.id);
      }
      fields[0]?.focus();
    };

    contactFields.forEach((field) => {
      field.addEventListener('input', () => {
        if (!field.hasAttribute('aria-invalid')) return;
        clearContactError();
        status.textContent = '';
        status.classList.remove('error');
      });
    });
    const redirectError = params.get('error');
    if (redirectError !== null) showError(redirectError);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!email.value.trim() && !phone.value.trim()) {
        showError('contact');
        return;
      }
      button.disabled = true;
      clearContactError();
      status.textContent = form.dataset.msgSending!;
      status.classList.remove('error');
      let error = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok === true) {
          location.href = form.dataset.sentUrl!;
          return;
        }
        if (typeof data.error === 'string') error = data.error;
      } catch {
        // Network errors use the general submission message.
      }
      button.disabled = false;
      showError(error);
    });
  });
</script>

<style>
  .form { display: grid; gap: 18px; }
  .contact { min-inline-size: 0; margin: 0; padding: 0; border: 0; }
  .contact legend { padding: 0; margin-block-end: 6px; font-size: var(--fs-sm); color: var(--label-muted, var(--muted)); }
  .contact-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; }
  .field { display: grid; gap: 6px; align-content: start; }
  label { font-size: var(--fs-sm); font-weight: 500; }
  label small { color: var(--label-muted, var(--muted)); font-weight: 400; }
  .hint { color: var(--label-muted, var(--muted)); font-size: var(--fs-sm); margin: 0; }
  input, select, textarea {
    font: inherit; color: var(--ink); background: #fff; border: 1.5px solid var(--field-border, var(--rule)); border-radius: 4px;
    min-height: 48px; padding: 10px 12px; width: 100%;
  }
  :global([dir='rtl']) input[dir='ltr'] { text-align: right; }
  input[aria-invalid="true"] { border-color: var(--error, #A3261B); }
  textarea { min-height: 96px; resize: vertical; }
  .submit { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .status { margin: 0; font-size: var(--fs-sm); }
  .status.error { color: var(--error, #A3261B); font-weight: 500; }
  /* Clipped in place rather than pushed off-screen, which would widen the page in RTL. */
  .trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  :global(.dark) .form { --label-muted: var(--on-dark-muted); --field-border: transparent; --error: #FFB4A8; }
  @media (max-width: 640px) {
    .contact-fields { grid-template-columns: 1fr; }
  }
</style>
