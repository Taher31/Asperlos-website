---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  intro?: string;
  /** Breadcrumb trail above the title, excluding the current page */
  trail?: { href: string; label: string }[];
}
const { lang, title, intro, trail = [] } = Astro.props;
const { h } = useTranslations(lang);
---
<header class="page-header">
  <div class="wrap">
    {trail.length > 0 && (
      <nav class="trail" aria-label="Breadcrumb">
        <ol>
          {trail.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ol>
      </nav>
    )}
    <h1>{title}</h1>
    {intro && <p class="intro" set:html={h(intro)} />}
  </div>
</header>

<style>
  .page-header { padding-block: clamp(40px, 6vw, 72px) clamp(24px, 4vw, 40px); }
  h1 { font-size: var(--fs-h1); line-height: var(--lh-tight); letter-spacing: var(--track-tight); font-weight: 600; margin: 0; }
  .intro { font-size: var(--fs-lead); color: var(--muted); max-width: 56ch; margin: 16px 0 0; }
  .trail ol { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; padding: 0; font-size: var(--fs-sm); }
  .trail li:not(:last-child)::after { content: '/'; margin-inline-start: 8px; color: var(--rule); }
  .trail a { color: var(--muted); text-underline-offset: 3px; }
</style>
