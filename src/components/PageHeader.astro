---
import Seed from './Seed.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  intro?: string;
  /** Breadcrumb trail above the title, excluding the current page */
  trail?: { href: string; label: string }[];
  /** Product slugs for the decorative seeds beside the title */
  seeds?: string[];
}
const { lang, title, intro, trail = [], seeds = ['chickpeas', 'red-lentils', 'seeded-raisins'] } = Astro.props;
const { h } = useTranslations(lang);
const spots = [
  { x: 10, y: 8, w: 40, r: -14 },
  { x: 58, y: 30, w: 32, r: 18 },
  { x: 22, y: 62, w: 28, r: 36 },
];
---
<header class="page-header">
  <div class="wrap inner">
    <div class="text">
      {trail.length > 0 && (
        <nav class="trail" aria-label="Breadcrumb">
          <ol>
            {trail.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ol>
        </nav>
      )}
      <h1 data-reveal>{title}</h1>
      {intro && <p class="intro" data-reveal style="--d:0.12s" set:html={h(intro)} />}
    </div>
    <div class="art" aria-hidden="true">
      {seeds.slice(0, 3).map((slug, i) => (
        <Seed
          product={slug}
          variant={i + 1}
          size={Math.round(spots[i].w * 2.8)}
          eager
          style={`left:${spots[i].x}%;top:${spots[i].y}%;width:${spots[i].w}%;--rot:${spots[i].r}deg;--t:${6 + i}s;--fd:${-i * 1.5}s`}
        />
      ))}
    </div>
  </div>
</header>

<style>
  .page-header { padding-block: clamp(40px, 7vw, 96px) clamp(32px, 5vw, 64px); overflow: hidden; }
  .inner { display: grid; grid-template-columns: 1fr 260px; gap: 40px; align-items: center; }
  h1 { font-size: var(--fs-h1); line-height: var(--lh-tight); margin: 0; text-wrap: balance; }
  .intro { font-size: var(--fs-lead); color: var(--muted); max-width: 56ch; margin: 20px 0 0; }
  .trail ol { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 20px; padding: 0; font-size: var(--fs-sm); }
  .trail li:not(:last-child)::after { content: '/'; margin-inline-start: 8px; color: var(--gold); }
  .trail a { color: var(--muted); text-underline-offset: 3px; }
  .art { position: relative; aspect-ratio: 1 / 1; }
  @media (max-width: 760px) {
    .inner { grid-template-columns: 1fr; }
    .art { display: none; }
  }
</style>
