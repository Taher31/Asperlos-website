---
import { geoMercator, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';

// Render the Natural Earth outline at build time.
const width = 560;
const height = 464;
const geometry = world.objects.countries.geometries.find((country) => String(country.id) === '364')!;
const iran = feature(world, geometry);
const projection = geoMercator().fitExtent([[8, 8], [width - 8, height - 8]], iran);
const outline = geoPath(projection).digits(1)(iran);
---

<svg data-iran-watermark viewBox={`0 0 ${width} ${height}`} width={width} height={height} aria-hidden="true" focusable="false">
  <defs>
    <pattern id="iran-stipple" patternUnits="userSpaceOnUse" width="9" height="9">
      <circle cx="2" cy="2" r="1.3" fill="currentColor" />
      <circle cx="6.5" cy="6.5" r=".95" fill="currentColor" />
    </pattern>
  </defs>
  <path d={outline} fill="url(#iran-stipple)" />
</svg>

<style>
  svg {
    position: absolute;
    inset-block-start: clamp(5.5rem, 14svh, 10rem);
    inset-inline-end: max(.5rem, calc((100% - var(--wrap)) / 4));
    width: clamp(9rem, 17vw, 17rem);
    height: auto;
    pointer-events: none;
    color: #73664f;
    opacity: .35;
  }
  path {
    stroke: currentColor;
    stroke-width: .85;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  @media (max-width: 640px) {
    svg {
      inset-block-start: 12svh;
      inset-inline-end: .35rem;
      width: clamp(6rem, 24vw, 8rem);
      opacity: .25;
    }
    path { fill: currentColor; fill-opacity: .18; }
  }
  @media (prefers-reduced-motion: no-preference) {
    svg { animation: iran-watermark-drift 22s ease-in-out infinite alternate; }
  }
  @keyframes iran-watermark-drift {
    to { transform: translate(4px, 6px); }
  }
</style>
