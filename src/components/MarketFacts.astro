---
// Public market figures with their sources (brand guide, section 8: every number needs a source).
// Texts live in src/i18n/*.json (market.items); the links are the same in every language.
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { dict } = useTranslations(lang);
const links = [
  'https://tass.com/economy/1755275',
  'https://www.interfax.com/newsroom/top-stories/108916/',
  'https://www.freshplaza.com/asia/article/9863336/uzbekistan-exports-47-700-tonnes-of-raisins-in-h1-2026/',
];
---
<section class="section market">
  <div class="wrap">
    <div class="head" data-reveal>
      <p class="eyebrow">{dict.market.eyebrow}</p>
      <h2 class="h2">{dict.market.title}</h2>
      <p class="section-intro">{dict.market.intro}</p>
    </div>
    <ol class="facts">
      {dict.market.items.map((item, i) => (
        <li data-reveal style={`--d:${i * 0.12}s`}>
          <span class="value display">{item.value}</span>
          <p class="text">{item.text}</p>
          <a class="source" href={links[i]} rel="noopener" target="_blank">{item.source}</a>
        </li>
      ))}
    </ol>
    <p class="note">{dict.market.note}</p>
  </div>
</section>

<style>
  .market { background: var(--navy-deep); color: #fff; --rule: rgba(255, 255, 255, 0.16); --focus: var(--gold); }
  .market .h2 { color: #fff; }
  .market .eyebrow { color: var(--gold); }
  .market .section-intro { color: var(--on-dark-muted); }
  .head { max-width: 720px; margin-bottom: clamp(32px, 5vw, 56px); }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 4vw, 56px); }
  li { border-top: 1px solid var(--rule); padding-top: 24px; position: relative; display: grid; align-content: start; gap: 12px; }
  li::before { content: ""; position: absolute; top: -1px; inset-inline-start: 0; width: 48px; height: 1px; background: var(--gold); }
  .value { font-size: clamp(2.4rem, 4.6vw, 3.6rem); line-height: 1; color: var(--gold); }
  .text { margin: 0; color: #fff; }
  .source { font-size: 0.8125rem; color: var(--on-dark-muted); text-underline-offset: 3px; }
  .source:hover { color: #fff; }
  .note { margin: 40px 0 0; font-size: 0.8125rem; color: var(--on-dark-muted); }
  @media (max-width: 860px) {
    .facts { grid-template-columns: 1fr; }
  }
</style>
