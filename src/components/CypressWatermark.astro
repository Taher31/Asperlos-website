---
import CypressBranches from './CypressBranches.astro';

interface Props {
  tone: 'paper' | 'navy';
}
const { tone } = Astro.props;
---

<div class:list={['cypress-watermark', tone]} data-cypress-watermark={tone} data-cypress={tone === 'navy' || undefined} aria-hidden="true">
  <div class="tree">
    <CypressBranches variant={`${tone}-watermark`} />
  </div>
</div>

<style>
  .cypress-watermark {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .tree {
    position: absolute;
    aspect-ratio: 2 / 3;
    filter: grayscale(1);
  }
  .tree :global([data-cypress-artwork]) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .paper .tree {
    height: clamp(22rem, 72svh, 44rem);
    inset-block-end: 6svh;
    inset-inline-end: max(-8rem, calc((100% - var(--wrap)) / 2 - 14rem));
    opacity: .16;
  }
  .navy { z-index: -1; }
  .navy .tree {
    height: clamp(13rem, 34vw, 27rem);
    inset-block-end: 1rem;
    inset-inline-end: max(0rem, calc((100% - var(--wrap)) / 2 - 1rem));
    opacity: .14;
  }
  @media (max-width: 640px) {
    .paper .tree {
      height: clamp(15rem, 42svh, 22rem);
      inset-inline-end: -5rem;
      opacity: .12;
    }
    .navy .tree { inset-inline-end: -2.5rem; opacity: .11; }
  }
</style>
