---
import CypressBranches from './CypressBranches.astro';

interface Props {
  tone: 'paper' | 'navy';
}
const { tone } = Astro.props;
---

<div class:list={['cypress-watermark', tone]} data-cypress-watermark={tone} data-cypress={tone === 'navy' || undefined} aria-hidden="true">
  <div class="tree">
    <CypressBranches variant={`${tone}-watermark`} />
  </div>
</div>

<style>
  .cypress-watermark {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .tree {
    position: absolute;
    aspect-ratio: 2 / 3;
    filter: grayscale(1);
  }
  .tree :global([data-cypress-artwork]) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .paper .tree {
    --tree-height: clamp(18rem, 52svh, 33rem);
    height: var(--tree-height);
    inset-block-end: -1.5rem;
    inset-inline-end: max(1.75rem, calc((100% - var(--wrap)) / 4 + 1.75rem));
    margin-inline-end: calc(var(--tree-height) / -3);
    filter: grayscale(1) sepia(.35);
    opacity: .29;
  }
  .navy { z-index: -1; }
  .navy .tree {
    height: clamp(13rem, 34vw, 27rem);
    inset-block-end: 1rem;
    inset-inline-end: max(0rem, calc((100% - var(--wrap)) / 2 - 1rem));
    opacity: .14;
  }
  @media (max-width: 640px) {
    .paper .tree {
      --tree-height: clamp(11rem, 32svh, 17rem);
      inset-block-end: 2.5rem;
      inset-inline-end: 1.25rem;
      opacity: .22;
    }
    .navy .tree { inset-inline-end: -2.5rem; opacity: .11; }
  }
</style>
