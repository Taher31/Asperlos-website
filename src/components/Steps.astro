---
// How we work: a real sequence, so the steps are numbered.
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { dict, h } = useTranslations(lang);
const num = (i: number) => (lang === 'fa' ? (i + 1).toLocaleString('fa-IR', { minimumIntegerDigits: 2 }) : String(i + 1).padStart(2, '0'));
---
<ol class="steps">
  {dict.how.steps.map((step, i) => (
    <li data-reveal style={`--d:${i * 0.1}s`}>
      <span class="n display" aria-hidden="true">{num(i)}</span>
      <h3>{step.t}</h3>
      <p set:html={h(step.d)} />
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px; }
  li { border-top: 1px solid var(--rule); padding-top: 22px; position: relative; }
  li::before { content: ""; position: absolute; top: -1px; inset-inline-start: 0; width: 40px; height: 1px; background: var(--gold); }
  .n { display: block; font-size: 3.2rem; line-height: 1; color: var(--gold-ink); margin-bottom: 18px; }
  h3 { font-size: 1.125rem; font-weight: 600; margin: 0 0 8px; }
  p { margin: 0; color: var(--muted); }

  @media (max-width: 960px) {
    .steps { grid-template-columns: 1fr 1fr; gap: 40px 28px; }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; gap: 32px; }
    .n { font-size: 2.6rem; }
  }
</style>
