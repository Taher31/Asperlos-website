---
import { Image } from 'astro:assets';
import logistics from '../assets/trade-logistics.webp';
import { localizePath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { dict } = useTranslations(lang);
---
<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <h1 class="hero-title">
        <span>{dict.hero.l1}</span>
        <span>{dict.hero.l2}</span>
        <span class="accent">{dict.hero.l3}</span>
      </h1>
      <p class="lead">{dict.hero.lead}</p>
      <div class="actions">
        <a class="btn btn-primary" href={localizePath(lang, '/inquiry/')}>{dict.cta.quote}</a>
        <a class="line-link" href="#services">{dict.cta.tradeServices}</a>
      </div>
    </div>

    <figure class="visual">
      <Image
        src={logistics}
        alt={dict.hero.imageAlt}
        widths={[480, 720, 1024, 1440]}
        sizes="(max-width: 880px) 90vw, (max-width: 1260px) 45vw, 580px"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{dict.hero.imageCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { min-height: min(760px, calc(100svh - var(--header-h))); display: grid; align-items: center; padding-block: clamp(40px, 7vw, 96px); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .hero-title { margin: 0 0 24px; font-size: var(--fs-hero); line-height: var(--lh-hero); }
  .hero-title span { display: block; text-wrap: balance; }
  .hero-title .accent { color: var(--gold-ink); font-style: italic; }
  :global(:root:lang(fa)) .hero-title .accent { font-style: normal; }
  .lead { font-size: var(--fs-lead); color: var(--muted); max-width: 48ch; margin: 0 0 32px; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 28px; }
  .visual { position: relative; margin: 0; padding-block-start: 12px; border-block-start: 1px solid var(--gold); }
  .visual img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; background: var(--sand); }
  .visual figcaption { color: var(--muted); font-size: 0.75rem; margin-block-start: 8px; }
  @media (max-width: 880px) {
    .hero { min-height: 0; }
    .grid { grid-template-columns: 1fr; }
    .visual { width: 100%; max-width: 620px; }
  }
</style>
