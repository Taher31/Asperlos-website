---
import CypressBranches from './CypressBranches.astro';

interface Props {
  variant: 'footer' | 'masthead';
}
const { variant } = Astro.props;
---

<div class:list={['cypress', variant]} data-cypress aria-hidden="true">
  {variant === 'masthead' && <div class="cypress-halo"></div>}
  <CypressBranches variant={variant} />
</div>

<style>
  .cypress {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    align-items: end;
    min-width: 0;
    touch-action: pan-y pinch-zoom;
  }
  .cypress-halo {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 12px;
    height: 1px;
    background: var(--gold);
    opacity: 0.24;
    pointer-events: none;
  }
  .cypress :global([data-cypress-artwork]) {
    position: relative;
    display: block;
    width: auto;
    height: var(--cypress-height);
  }
  .footer {
    --cypress-height: clamp(114px, 14vw, 177px);
  }
  .masthead {
    --cypress-height: clamp(145px, 19vw, 246px);
    width: min(100%, 240px);
    min-height: clamp(190px, 24vw, 300px);
    margin-inline: auto;
    padding: 18px 0 12px;
    border: 1px solid #c3922d75;
    border-radius: 50% 50% 4px 4px / 40% 40% 4px 4px;
    background: var(--navy-deep);
  }
  .masthead .cypress-halo { inset-inline: 14%; inset-block-end: 17px; }
</style>
