---
import { Image } from 'astro:assets';
import cypress from '../assets/footer-cypress.webp';
---
<span class="cypress-badge" aria-hidden="true">
  <Image src={cypress} alt="" height={54} densities={[1, 2]} format="webp" loading="lazy" />
</span>

<style>
  .cypress-badge {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: clamp(54px, 6vw, 68px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background: var(--navy-deep);
  }
  .cypress-badge img { height: clamp(42px, 4.6vw, 54px); width: auto; }
</style>
