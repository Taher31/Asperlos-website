---
// The brand's "route" (docs/brand-guide.md, section 11): two origin lines converging on Iran, drawn when scrolled into view.
// A schematic, not a geographic map: positions only hint at north (Russia), north-east (Uzbekistan) and south (Iran).
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { dict } = useTranslations(lang);
const W = 600;
const H = 520;
const nodes = {
  russia: { x: 170, y: 92 },
  uzbekistan: { x: 462, y: 214 },
  iran: { x: 318, y: 416 },
};
const pos = (n: { x: number; y: number }) => `left:${((n.x / W) * 100).toFixed(2)}%;top:${((n.y / H) * 100).toFixed(2)}%`;
const routeA = `M${nodes.russia.x},${nodes.russia.y} C110,250 190,392 ${nodes.iran.x},${nodes.iran.y}`;
const routeB = `M${nodes.uzbekistan.x},${nodes.uzbekistan.y} C486,310 430,392 ${nodes.iran.x},${nodes.iran.y}`;
---
<div class="map" data-reveal aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} focusable="false">
    <defs>
      <pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="9" cy="9" r="1.1" />
      </pattern>
      <radialGradient id="fade">
        <stop offset="0.55" stop-color="#fff" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </radialGradient>
      <mask id="fade-mask"><rect width={W} height={H} fill="url(#fade)" /></mask>
    </defs>
    <rect class="grid" width={W} height={H} fill="url(#dots)" mask="url(#fade-mask)" />
    <path class="ghost" d={routeA} />
    <path class="ghost" d={routeB} />
    <path class="route" d={routeA} pathLength="1" />
    <path class="route b" d={routeB} pathLength="1" />
    <circle class="ship" r="4"><animateMotion dur="7s" repeatCount="indefinite" path={routeA} /></circle>
    <circle class="ship" r="4"><animateMotion dur="6s" begin="1.5s" repeatCount="indefinite" path={routeB} /></circle>
    <circle class="node" cx={nodes.russia.x} cy={nodes.russia.y} r="7" />
    <circle class="node" cx={nodes.uzbekistan.x} cy={nodes.uzbekistan.y} r="7" />
    <circle class="pulse" cx={nodes.iran.x} cy={nodes.iran.y} r="10" />
    <circle class="node end" cx={nodes.iran.x} cy={nodes.iran.y} r="10" />
  </svg>
  <span class="label" style={pos(nodes.russia)}><b class="display">{dict.origins.russia}</b>{dict.home.mapSaratov}</span>
  <span class="label right" style={pos(nodes.uzbekistan)}><b class="display">{dict.origins.uzbekistan}</b></span>
  <span class="label dest" style={pos(nodes.iran)}><b class="display">{dict.home.mapIran}</b>{dict.home.mapMashhad}</span>
</div>

<style>
  .map { position: relative; width: 100%; aspect-ratio: 600 / 520; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  pattern circle { fill: #C9BEA9; }
  .ghost { fill: none; stroke: var(--rule); stroke-width: 1; stroke-dasharray: 3 6; }
  .route { fill: none; stroke: var(--gold); stroke-width: 2.5; stroke-linecap: round; }
  .node { fill: var(--paper); stroke: var(--navy); stroke-width: 2.5; }
  .node.end { fill: var(--gold); stroke: var(--navy); }
  .pulse { fill: none; stroke: var(--gold); stroke-width: 1.5; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .ship { fill: var(--navy); display: none; }

  :global(.motion) .route { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.8s cubic-bezier(0.6, 0.05, 0.3, 1) 0.2s; }
  :global(.motion) .route.b { transition-delay: 0.5s; }
  :global(.motion) .map:global(.is-in) .route { stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .map:global(.is-in) .ship { display: block; }
    .map:global(.is-in) .pulse { animation: pulse 2.4s ease-out 2s infinite; }
  }
  @keyframes pulse { from { opacity: 0.9; transform: scale(1); } to { opacity: 0; transform: scale(3.2); } }

  .label {
    position: absolute; display: grid; gap: 0; transform: translate(14px, -50%);
    font-size: var(--fs-sm); color: var(--muted); line-height: 1.35; white-space: nowrap;
  }
  .label b { font-size: 1.6rem; font-weight: 500; color: var(--navy); line-height: 1.1; }
  /* Uzbekistan sits near the east edge: its label goes on the west side of the node in both directions. */
  .label.right, :global([dir='rtl']) .label.right { transform: translate(calc(-100% - 14px), -50%); text-align: end; }
  .label.dest { transform: translate(-50%, 18px); text-align: center; }
  :global([dir='rtl']) .label { transform: translate(calc(-100% - 14px), -50%); text-align: right; }
  :global([dir='rtl']) .label.dest { transform: translate(-50%, 18px); text-align: center; }
  @media (max-width: 520px) {
    .label b { font-size: 1.25rem; }
  }
</style>
