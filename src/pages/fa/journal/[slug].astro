---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatJournalDate, getJournalEntries, journalPath } from '../../../lib/journal';
import fa from '../../../i18n/fa.json';

export async function getStaticPaths() {
  return (await getJournalEntries()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'journal'> };
const { Content } = await render(entry);
const { title, summary, date, category, sources, linkedinUrl, linkedinEmbedUrl } = entry.data;
const dateIso = date.toISOString().slice(0, 10);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  url: new URL(journalPath(entry.id), Astro.site).href,
  headline: title,
  description: summary,
  datePublished: dateIso,
  inLanguage: 'fa',
  author: { '@type': 'Organization', name: fa.meta.siteName },
};
---
<BaseLayout lang="fa" title={title} description={summary} schema={[schema]} ogType="article" languageFallback="/journal/">
  <article class="wrap article">
    <header class="article-head">
      <a class="text-link" href="/fa/journal/">{fa.journal.title}</a>
      <p class="meta">
        <span>{fa.journal.categories[category]}</span>
        <time datetime={dateIso}>{formatJournalDate(date)}</time>
      </p>
      <h1>{title}</h1>
      <p class="intro">{summary}</p>
    </header>
    <div class:list={['article-grid', { 'with-social': linkedinUrl || linkedinEmbedUrl }]}>
      <div>
        <div class="prose copy"><Content /></div>
        {sources.length > 0 && (
          <section class="sources" aria-labelledby="journal-sources">
            <h2 id="journal-sources" class="display">{fa.journal.sources}</h2>
            <ul>
              {sources.map((source) => <li><a class="text-link" href={source.url} dir="auto">{source.label}</a></li>)}
            </ul>
          </section>
        )}
      </div>
      {(linkedinUrl || linkedinEmbedUrl) && (
        <aside class="post" aria-labelledby="related-linkedin">
          <h2 id="related-linkedin" class="display">{fa.journal.linkedinPost}</h2>
          {linkedinEmbedUrl && <iframe src={linkedinEmbedUrl} title={fa.journal.linkedinPost} loading="lazy"></iframe>}
          {linkedinUrl && <a class="text-link" href={linkedinUrl} rel="noopener" target="_blank">{fa.journal.openLinkedinPost}</a>}
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .article { padding-block: clamp(36px, 7vw, 96px); }
  .article-head { max-width: 760px; border-bottom: 1px solid var(--rule); margin-block-end: 32px; padding-block-end: 20px; }
  .meta { display: flex; flex-wrap: wrap; gap: 2px 16px; color: var(--muted); font-size: var(--fs-sm); margin: 18px 0 8px; }
  .meta span { color: var(--gold-ink); font-weight: 600; }
  h1 { font-size: var(--fs-h1); line-height: var(--lh-tight); margin: 0 0 12px; }
  .intro { font-size: var(--fs-lead); color: var(--muted); margin: 0; }
  .with-social { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 52px); }
  .copy { line-height: 1.95; overflow-x: auto; }
  .copy :global(h2) { font-size: var(--fs-h3); line-height: var(--lh-tight); margin: 24px 0 8px; }
  .copy :global(table) { border-collapse: collapse; width: 100%; margin-block: 18px; }
  .copy :global(th), .copy :global(td) { padding: 10px; border: 1px solid var(--rule); text-align: start; vertical-align: top; }
  .copy :global(th) { background: var(--sand); }
  .copy :global(blockquote) { border-inline-start: 3px solid var(--gold); margin-inline: 0; padding-inline-start: 18px; }
  .sources { max-width: var(--measure); margin-block-start: 32px; border-block-start: 1px solid var(--rule); padding-block-start: 20px; }
  .sources h2, .post h2 { font-size: var(--fs-h3); margin: 0 0 8px; }
  .sources ul { margin: 0; padding-inline-start: 1.3em; }
  .post { align-self: start; padding: 18px; border: 1px solid var(--rule); border-block-start-color: var(--gold); background: var(--card); border-radius: 4px; }
  .post iframe { width: 100%; height: 400px; margin-block-end: 8px; border: 0; }
  @media (max-width: 850px) { .with-social { grid-template-columns: 1fr; } }
</style>
