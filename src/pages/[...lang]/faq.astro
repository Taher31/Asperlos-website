---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { langPaths, localizePath, useTranslations, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const { dict } = useTranslations(lang);

// FAQPage structured data repeats the visible questions and answers, so search engines and AI assistants can quote them.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: dict.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---
<BaseLayout lang={lang} title={dict.faq.title} description={dict.meta.faqDescription} schema={schema}>
  <PageHeader lang={lang} title={dict.faq.title} intro={dict.faq.intro} />
  <section class="section">
    <div class="wrap">
      <dl class="faq">
        {dict.faq.items.map((item) => (
          <div>
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))}
      </dl>
      <div class="actions">
        <a class="btn btn-primary" href={localizePath(lang, '/inquiry/')}>{dict.cta.quote}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq { margin: 0; display: grid; max-width: 760px; border-top: 1px solid var(--rule); }
  .faq div { padding: 20px 0; border-bottom: 1px solid var(--rule); }
  dt { font-size: 1.125rem; font-weight: 600; color: var(--navy); margin-bottom: 8px; }
  dd { margin: 0; }
  .actions { margin-top: 32px; }
</style>
