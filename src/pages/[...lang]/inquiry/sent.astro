---
// Confirmation page after the inquiry form; inquiry.php redirects here (and the form script navigates here).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { langPaths, localizePath, useTranslations, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const { dict } = useTranslations(lang);
---
<BaseLayout lang={lang} title={dict.inquiry.sentTitle} description={dict.inquiry.sentTitle} noindex>
  <PageHeader lang={lang} title={dict.inquiry.sentTitle} intro={dict.inquiry.sentText} />
  <div class="wrap back">
    <a class="btn btn-secondary" href={localizePath(lang, '/')}>{dict.inquiry.backHome}</a>
  </div>
</BaseLayout>

<style>
  .back { padding-bottom: clamp(56px, 8vw, 96px); }
</style>
