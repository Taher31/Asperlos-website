---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactChannels from '../../components/ContactChannels.astro';
import { mapEmbedUrl, mapUrl } from '../../lib/contact';
import { langPaths, localizePath, useTranslations, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const { dict } = useTranslations(lang);
---
<BaseLayout lang={lang} title={dict.contact.title} description={dict.meta.contactDescription}>
  <PageHeader lang={lang} title={dict.contact.title} intro={dict.contact.intro} />
  <section class="section">
    <div class="wrap grid">
      <div>
        <ContactChannels lang={lang} />
        <div class="actions">
          <a class="btn btn-primary" href={localizePath(lang, '/inquiry/')}>{dict.cta.quote}</a>
        </div>
      </div>
      <div class="side">
        <dl class="facts">
          <div>
            <dt>{dict.contact.location}</dt>
            <dd>{dict.contact.locationValue}</dd>
          </div>
        </dl>
        <figure class="city-map">
          <iframe
            title={dict.contact.mapTitle}
            src={mapEmbedUrl(lang)}
            width="520"
            height="320"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
          <figcaption>
            <span>{dict.contact.mapTitle}</span>
            <a class="text-link" href={mapUrl} rel="noopener" target="_blank">{dict.contact.map}</a>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .actions { margin-top: 32px; }
  .facts { margin: 0; }
  .city-map { margin: 20px 0 0; border: 1px solid var(--rule); border-radius: 4px; background: var(--card); }
  .city-map iframe {
    display: block;
    width: 100%;
    height: clamp(280px, 35vw, 360px);
    border: 0;
    border-radius: 3px 3px 0 0;
    background: var(--sand);
  }
  .city-map figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 14px 16px;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-sm);
  }
  .city-map figcaption span { color: var(--muted); }
  dt { color: var(--muted); font-size: var(--fs-sm); margin-bottom: 4px; }
  dd { margin: 0; font-weight: 500; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
