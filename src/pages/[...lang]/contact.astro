---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactChannels from '../../components/ContactChannels.astro';
import { mapUrl } from '../../lib/contact';
import { langPaths, localizePath, useTranslations, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const { dict, h } = useTranslations(lang);
---
<BaseLayout lang={lang} title={dict.contact.title} description={dict.meta.contactDescription}>
  <PageHeader lang={lang} title={dict.contact.title} intro={dict.contact.intro} />
  <section class="section">
    <div class="wrap grid">
      <div>
        <ContactChannels lang={lang} />
        <div class="actions">
          <a class="btn btn-primary" href={localizePath(lang, '/inquiry/')}>{dict.cta.quote}</a>
        </div>
      </div>
      <dl class="facts">
        <div>
          <dt>{dict.contact.address}</dt>
          <dd>
            <span set:html={h(dict.contact.addressValue)} />
            {mapUrl && <a class="text-link map" href={mapUrl} rel="noopener" target="_blank">{dict.contact.map}</a>}
          </dd>
        </div>
        <div>
          <dt>{dict.contact.hours}</dt>
          <dd set:html={h(dict.contact.hoursValue)} />
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .actions { margin-top: 32px; }
  .facts { margin: 0; display: grid; gap: 24px; }
  dt { color: var(--muted); font-size: var(--fs-sm); margin-bottom: 4px; }
  dd { margin: 0; font-weight: 500; }
  .map { display: inline-block; margin-top: 8px; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
