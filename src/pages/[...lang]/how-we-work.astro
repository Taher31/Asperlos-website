---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Steps from '../../components/Steps.astro';
import { langPaths, localizePath, useTranslations, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const { dict, h } = useTranslations(lang);
---
<BaseLayout lang={lang} title={dict.how.title} description={dict.meta.howDescription}>
  <PageHeader lang={lang} title={dict.how.title} intro={dict.how.intro} />
  <section class="section">
    <div class="wrap">
      <Steps lang={lang} />
    </div>
  </section>
  <section class="section alt">
    <div class="wrap">
      <h2 class="h2">{dict.how.termsTitle}</h2>
      <p class="prose" set:html={h(dict.how.terms)} />
      <div class="actions">
        <a class="btn btn-primary" href={localizePath(lang, '/inquiry/')}>{dict.cta.quote}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .actions { margin-top: 32px; }
</style>
