---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { langPaths, localizePath, useTranslations, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const { dict } = useTranslations(lang);
const facts = [
  [dict.about.founded, dict.about.foundedValue],
  [dict.contact.location, dict.contact.locationValue],
];
---
<BaseLayout lang={lang} title={dict.about.title} description={dict.meta.aboutDescription}>
  <PageHeader lang={lang} title={dict.about.title} intro={dict.about.intro} />

  <section class="section">
    <div class="wrap">
      <h2 class="h2">{dict.about.factsTitle}</h2>
      <dl class="facts">
        {facts.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <p class="links"><a class="text-link" href={localizePath(lang, '/#services')}>{dict.cta.tradeServices}</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2 class="h2">{dict.about.catalogueTitle}</h2>
      <p class="section-intro">{dict.about.catalogueText}</p>
      <p class="links">
        <a class="text-link" href={localizePath(lang, '/products/')}>{dict.cta.allProducts}</a>
        <a class="text-link" href={localizePath(lang, '/origins/')}>{dict.nav.origins}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .facts { margin: 24px 0 0; display: grid; border-top: 1px solid var(--rule); max-width: 760px; }
  .facts div { display: grid; grid-template-columns: 220px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  dt { color: var(--muted); }
  dd { margin: 0; font-weight: 500; }
  .links { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 24px 0 0; }
  @media (max-width: 640px) {
    .facts div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
