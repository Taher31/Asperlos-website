---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ProductTable from '../../../components/ProductTable.astro';
import { getProducts } from '../../../lib/content';
import { categories } from '../../../content.config';
import { langPaths, localizePath, useTranslations, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const { dict } = useTranslations(lang);
const products = await getProducts(lang);
---
<BaseLayout lang={lang} title={dict.products.title} description={dict.meta.productsDescription}>
  <PageHeader lang={lang} title={dict.products.title} intro={dict.products.intro} />
  <section class="section alt">
    <div class="wrap">
      <nav class="cats" aria-label={dict.products.title}>
        {categories.map((c) => <a href={localizePath(lang, `/products/${c}/`)}>{dict.categories[c].name}</a>)}
        <a href={localizePath(lang, '/origins/')}>{dict.nav.origins}</a>
      </nav>
      <ProductTable lang={lang} products={products} />
    </div>
  </section>
</BaseLayout>

<style>
  .cats { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 32px; }
  .cats a { color: var(--navy); font-weight: 500; text-underline-offset: 4px; }
</style>
